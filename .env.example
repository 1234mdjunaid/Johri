# PocketBase server URL (self-hosted). No trailing slash.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Shown as a hint on the admin login screen only — the real credential lives
# in PocketBase's "admins" auth collection (create the owner's account there).
VITE_ADMIN_EMAIL=owner@johrijewellers.com

# Fallback WhatsApp number / business name used before the admin fills in
# Settings for the first time. Include the country code, digits only.
VITE_WHATSAPP_NUMBER=919161191676
VITE_BUSINESS_NAME=Johri Jewellers

# Public URL the app is deployed at (used for metadata only).
VITE_APP_URL=https://spin.johrijewellers.com
